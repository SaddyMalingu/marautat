# Ignore environment variable files
.env
.env.*

# Scratch files from live verification runs. These carried the canary output, the
# deploy poller and byte-level checks; they are evidence, not source, and they were
# dirtying every `git status` during the admin-console work.
.canary*.txt
.v_*.txt
.live_*.txt
.ps*.txt
.wait_deploy.ps1
.run_live.ps1

# More scratch from live verification: route/landing audits and the z_* probe
# outputs. They are evidence copied out of terminals, never inputs to a build.
.audit*
.g.txt
.m4.txt
z_ready.json
z_rev.json
z_risk.json
z_run1.txt
