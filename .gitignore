# Ignore environment variable files
.env
.env.*

# Scratch files from live verification runs. These carried the canary output, the
# deploy poller and byte-level checks; they are evidence, not source, and they were
# dirtying every `git status` during the admin-console work.
.canary*.txt
.v_*.txt
.live_*.txt
.ps*.txt
.wait_deploy.ps1
.run_live.ps1

# More scratch from live verification: route/landing audits and the z_* probe
# outputs. They are evidence copied out of terminals, never inputs to a build.
.audit*
.g.txt
.m4.txt
z_ready.json
z_rev.json
z_risk.json
z_run1.txt

# local capture artifacts (collector progress, collected roles, referral candidates)
tmp/
# operator run logs from capture sessions (active run keeps writing its own)
tmp_*.log
tmp_*.json
tmp_*.txt

# Browser Actor inspection artifacts (screenshots + DOM dumps of a logged-in account)
tmp_inspect/

# Written by the worker at startup when it records which local MoreLogin profile it uses.
# No secret inside, but it describes one tenant's machine, so it does not belong in git.
worker-config.json
